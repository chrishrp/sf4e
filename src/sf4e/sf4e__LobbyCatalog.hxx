// Shared UI palette; these are fork design tokens, not sampled game pixels.
struct RGB { unsigned char r, g, b; };
inline RGB UltraColor(int selection) {
    static const RGB colors[3] = { {255, 117, 51}, {67, 173, 255}, {187, 115, 255} };
    return colors[selection >= 0 && selection < 3 ? selection : 0];
}

