// Edition values are the engine IDs: SFIV=13, Super=1, AE=2, 2012=4, Ultra=14.
// Omega (16) is deliberately unverified; nullptr permits an explicit reference label.
inline const Ultra* FindUltra(int characterId, int ultraIndex, int edition = 14) {
    const Fighter* fighter = Find(characterId);
    if (!fighter || ultraIndex < 0 || ultraIndex > 1) return nullptr;
    if (edition != 13 && edition != 1 && edition != 2 && edition != 4 && edition != 14) return nullptr;
    if (edition == 13 && ultraIndex != 0) return nullptr;
    static const unsigned int validEditionMask[CharacterCount] = {
        90134u, 90134u, 90134u, 90134u, 90134u, 90134u, 90134u, 90134u,
        90134u, 90134u, 90134u, 90134u, 90134u, 90134u, 90134u, 90134u,
        90134u, 90134u, 90134u, 81942u, 90134u, 90134u, 81942u, 90134u,
        90134u, 90134u, 90134u, 81942u, 81942u, 81942u, 81942u, 81942u,
        81942u, 81942u, 81942u, 81940u, 81940u, 81940u, 81940u, 81920u,
        81920u, 81920u, 81920u, 81920u,
    };
    if (!(validEditionMask[characterId] & (1u << edition))) return nullptr;
    struct Override { int edition, character, ultra; Ultra move; };
    static const Override overrides[] = {
        {1, 3, 1, {"Orochi Breaker", "720 + PPP", ""}},
        {1, 7, 1, {"Yoga Shangri-La", "AIR D DF F D DF F + PPP", ""}},
        {1, 8, 1, {"Dirty Bull", "720 + PPP", ""}},
        {1, 19, 1, {"Raging Slash", "F DF D DB B F DF D DB B + PPP", ""}},
        {1, 24, 1, {"Soul Satellite", "D DB B D DB B + PPP", ""}},
        {2, 7, 1, {"Yoga Shangri-La", "AIR D DF F D DF F + PPP", ""}},
        {2, 11, 1, {"Psycho Punisher", "CHARGE B F B F + PPP", ""}},
        {2, 19, 1, {"Raging Slash", "F DF D DB B F DF D DB B + PPP", ""}},
        {2, 24, 1, {"Soul Satellite", "D DB B D DB B + PPP", ""}},
        {2, 38, 1, {"Tenchi Sokaigen", "B DB D DF F B DB D DF F + PPP", ""}},
        {4, 7, 1, {"Yoga Shangri-La", "AIR D DF F D DF F + PPP", ""}},
        {4, 11, 1, {"Psycho Punisher", "CHARGE B F B F + PPP", ""}},
        {4, 19, 1, {"Raging Slash", "F DF D DB B F DF D DB B + PPP", ""}},
        {4, 24, 1, {"Soul Satellite", "D DB B D DB B + PPP", ""}},
        {4, 38, 1, {"Tenchi Sokaigen", "B DB D DF F B DB D DF F + PPP", ""}},
    };
    for (const Override& value : overrides)
        if (value.edition == edition && value.character == characterId && value.ultra == ultraIndex) return &value.move;
    return &fighter->ultra[ultraIndex];
}

