 /*
+ * ggpo_get_last_confirmed_frame --
+ *
+ * sf4e: the newest frame for which every player's input has actually arrived,
+ * so it can no longer be rolled back. Callers that need to know a frame has
+ * SETTLED -- comparing state between peers, publishing a match result -- can
+ * ask instead of assuming that some number of frames of age is enough. That
+ * assumption is only ever right by luck.
+ *
+ * Returns GGPO_ERRORCODE_UNSUPPORTED on backends that do not track it.
+ */
+GGPO_API GGPOErrorCode __cdecl ggpo_get_last_confirmed_frame(GGPOSession *,
+                                                             int *frame);
+
+/*
+ * ggpo_set_assert_handler --
+ *
+ * sf4e: called with the assertion text when an internal invariant breaks.
+ * Without one, GGPO used to pop a modal dialog (freezing the caller's thread)
+ * and then exit(0) -- a clean exit that no crash handler can catch, leaving no
+ * dump and no log. Install one, log the text, and tear the SESSION down.
+ *
+ * The handler runs on whichever thread tripped the assertion, and GGPO's state
+ * is inconsistent by the time it is called: log, signal, and return. Do not
+ * call back into GGPO from it.
+ */
+GGPO_API void __cdecl ggpo_set_assert_handler(void (__cdecl *handler)(const char *msg));
+
+/*
+ * ggpo_get_unconfirmed_depth --
+ *
+ * sf4e: how many frames back the confirmed boundary sits from the present.
+ * Callers number their own frames differently from GGPO, so an absolute frame
+ * number cannot be compared against theirs -- but a depth can. Use this to ask
+ * "is a frame this far back settled yet?".
+ */
+GGPO_API GGPOErrorCode __cdecl ggpo_get_unconfirmed_depth(GGPOSession *,
+                                                          int *depth);
+
+/*
  * ggpo_log --
  *
  * Used to write to the ggpo.net log.  In the current versions of the
