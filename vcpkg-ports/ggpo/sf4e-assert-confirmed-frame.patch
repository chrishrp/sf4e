+// sf4e: set by ggpo_set_assert_handler; read by Platform::AssertFailed.
+// Defined here so the whole library shares one, and NULL until the host
+// installs one (in which case AssertFailed falls back to OutputDebugString).
+void (__cdecl *g_ggpo_assert_handler)(const char *msg) = NULL;
+
+void __cdecl
+ggpo_set_assert_handler(void (__cdecl *handler)(const char *msg))
+{
+   g_ggpo_assert_handler = handler;
+}
+
+GGPOErrorCode __cdecl
+ggpo_get_last_confirmed_frame(GGPOSession *ggpo, int *frame)
+{
+   if (!ggpo || !frame) {
+      return GGPO_ERRORCODE_INVALID_SESSION;
+   }
+   return ggpo->GetLastConfirmedFrame(frame);
+}
+
+GGPOErrorCode __cdecl
+ggpo_get_unconfirmed_depth(GGPOSession *ggpo, int *depth)
+{
