diff -ruN a/src/lib/ggpo/network/udp_proto.cpp b/src/lib/ggpo/network/udp_proto.cpp
--- a/src/lib/ggpo/network/udp_proto.cpp	2026-09-17 09:53:22.601736700 +0200
+++ b/src/lib/ggpo/network/udp_proto.cpp	2026-09-17 10:59:41.966293400 +0200
@@ -479,7 +479,14 @@
       Log("%s input ack.\n", prefix);
       break;
    default:
-      ASSERT(FALSE && "Unknown UdpMsg type.");
+      // sf4e: was ASSERT(FALSE). Anything at all can send a datagram to this
+      // port -- a NAT-traversal probe, another protocol, a stray packet,
+      // someone spraying it -- and this is a LOGGING function. Killing the
+      // process from inside a log call, on unvalidated network input, is never
+      // right. Worse, it also fires on the "recv rejecting" path above, so a
+      // packet GGPO had ALREADY decided to discard still took the game down.
+      Log("%s unknown message type %d, ignored.\n", prefix, msg->hdr.type);
+      break;
    }
 }
 
diff -ruN a/src/lib/ggpo/platform_windows.h b/src/lib/ggpo/platform_windows.h
--- a/src/lib/ggpo/platform_windows.h	2026-09-17 09:53:11.326966200 +0200
+++ b/src/lib/ggpo/platform_windows.h	2026-09-17 09:53:34.917328900 +0200
@@ -20,7 +20,17 @@
 
 public:  // functions
    static ProcessID GetProcessID() { return GetCurrentProcessId(); }
-   static void AssertFailed(char *msg) { MessageBoxA(NULL, msg, "GGPO Assertion Failed", MB_OK | MB_ICONEXCLAMATION); }
+   // sf4e: a MessageBox here blocks the thread that called it -- the game
+   // thread -- so the game froze behind a dialog nobody could see, and the
+   // ASSERT macro then exited the process. Hand the text to the host instead.
+   static void AssertFailed(char *msg) {
+      extern void (__cdecl *g_ggpo_assert_handler)(const char *msg);
+      if (g_ggpo_assert_handler) {
+         g_ggpo_assert_handler(msg);
+         return;
+      }
+      OutputDebugStringA(msg);
+   }
    static uint32 GetCurrentTimeMS() { return timeGetTime(); }
    static int GetConfigInt(const char* name);
    static bool GetConfigBool(const char* name);
