+// sf4e: how many frames every peer is forced to roll back and re-simulate each
+// frame (see Sync::CheckSimulation). Keeps both peers permanently in the
+// "restored" state so the host game's lossy actor restore runs identically on
+// both and they stay in sync under asymmetric latency (CGNAT). Must be <=
+// MAX_PREDICTION_FRAMES so the target stays inside the saved-state ring, and it
+// drives how many extra confirmed inputs SetLastConfirmedFrame retains.
+#define SF4E_FORCED_ROLLBACK_DEPTH 2
+
+// sf4e: a unique marker baked into the compiled binary so a build can be
+// verified to actually contain this patch (grep GGPO.dll for the string).
+// Referenced from CheckSimulation via a volatile read so the linker keeps it.
+extern const volatile char* const SF4E_ROLLBACK_TAG;
+const volatile char* const SF4E_ROLLBACK_TAG = "SF4E_SYMROLLBACK_ROBUST_D2";
+
